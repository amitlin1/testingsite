# ============================================================
#  STRICT .gitignore
#  Commit ONLY source code, config & docs.
#  Dependencies, build output, data, secrets and EVERY archive
#  (zip / tar / gz / 7z / iso ...) are deliberately kept out.
#  Ref: https://help.github.com/articles/ignoring-files/
# ============================================================

# ---------- Dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Offline / air-gapped npm caches ----------
.npm-offline/
/.temp-npm-cache
/OFFLINE_NPM
/OFFLINE_NPM_LINUX

# ---------- Build / output ----------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ---------- Generated code ----------
/src/generated/prisma

# ---------- Tests / coverage ----------
/coverage

# ============================================================
#  Archives & compressed files  — NEVER commit
# ============================================================
*.zip
*.tar
*.tar.*
*.tgz
*.gz
*.bz2
*.bz
*.xz
*.7z
*.rar
*.lz
*.lzma
*.lz4
*.zst
*.cab

# Air-gap docker image bundles (e.g. prod-deploy/**/images/*.tar)
**/images/*.tar
**/images/*.tar.gz

# Vendored portable DBeaver shipped alongside the air-gap bundles: a third-party
# binary distribution (~75 MB of JRE per copy), not project source.
prod-deploy/*/dbeaver/

# ---------- prod-deploy: everything that carries a real secret ----------
# The TEMPLATES are committed; the filled-in files never are.
# (the filled-in prod-deploy/*/.env files are covered by the .env rules further
# down, together with the negation that keeps the .env.template files tracked)
#
# Produced by scripts/export-keycloak-seed.ps1 — a full dump of the Keycloak
# database, containing password hashes and both client secrets.
prod-deploy/db-server/keycloak-seed/keycloak-seed.sql

# ---------- Disk / VM / container images ----------
*.iso
*.img
*.dmg
*.vhd
*.vhdx
*.vmdk
*.qcow2
*.ova
*.ovf

# ---------- Compiled binaries ----------
*.exe
*.dll
*.so
*.so.*
*.dylib
*.o
*.a
*.lib
*.class
*.jar
*.war
*.node

# ---------- Databases & data directories ----------
/pgadmin-data
/minio-data
/postgres-data
*.sqlite
*.sqlite3
*.db

# ============================================================
#  Secrets / environment  — NEVER commit
# ============================================================
.env
.env.*
# ...but the deployment TEMPLATES carry no secrets and MUST be committed - they
# are the only documentation of what each server needs. This negation has to sit
# AFTER the `.env.*` rule above: within one .gitignore the LAST matching pattern
# wins, so a negation placed earlier is silently overridden.
!prod-deploy/*/.env.template
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ---------- Logs / debug ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Editor / OS cruft ----------
.DS_Store
Thumbs.db
nul

# ---------- Deploy / misc ----------
.vercel

# ---------- Design handoff reference (input material, not app code) ----------
/שיפור פרויקט עם design system/
/שיפור פרויקט עם design system.zip
/שיפור פרויקט עם design system (1)/
/שיפור פרויקט עם design system (1)/
