# ===========================================================================
# DB SERVER  -  copy to .env and fill in every <<< >>> marker
# ===========================================================================
# Fill THIS file first. The APP server's .env repeats six of these values, and
# each line there says which line here it must match.
#
# NOTE: passwords take effect only when the data volume is created (first start).
# Changing them later does not change the stored credentials.
# ===========================================================================


# --- PostgreSQL -----------------------------------------------------------
# ONE PostgreSQL serving TWO databases, so one port covers both.
# If something else on this machine already listens on 5432, change it here and
# in the APP server's DB_PORT - nothing else moves.
# Check first:   netstat -ano | findstr :5432
# -> APP server: DB_PORT
POSTGRES_PORT=5432

# Database 1 - the application.    -> APP server: DB_USER / DB_NAME
POSTGRES_USER=appuser
POSTGRES_DB=testingsite
# -> APP server: DB_PASSWORD
POSTGRES_PASSWORD=<<< SET A PASSWORD >>>

# Database 2 - Keycloak. Same PostgreSQL, same port, so the same backup job
# covers it. Created automatically on first start.
KEYCLOAK_DB_NAME=keycloak
# -> APP server: KC_DB_USERNAME
KEYCLOAK_DB_USER=keycloak
# -> APP server: KC_DB_PASSWORD
KEYCLOAK_DB_PASSWORD=<<< SET A PASSWORD >>>


# --- MinIO (file storage) --------------------------------------------------
# -> APP server: MINIO_PORT
MINIO_PORT=9000
# Admin console. Restrict to admin machines.
MINIO_CONSOLE_PORT=9001
# -> APP server: MINIO_ROOT_USER
MINIO_ROOT_USER=digitalfactory-admin
# -> APP server: MINIO_ROOT_PASSWORD
MINIO_ROOT_PASSWORD=<<< SET A PASSWORD >>>
# Bucket mirrored by the backup container. The app creates its buckets itself.
MINIO_BUCKET=digitalfactory-files


# --- Backups ---------------------------------------------------------------
# Host folders on THIS machine. Copy them off-site periodically.
BACKUP_FILES_PATH=C:/backups/files
BACKUP_PG_PATH=C:/backups/postgres
# 86400 = once a day. Daily dumps are pruned; monthly ones are kept forever.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_DAILY_RETENTION_DAYS=7


# ===========================================================================
# Write down this machine's IP - the APP server needs it as DB_HOST.
# Open ports 5432 and 9000 to the APP server's IP only.
# ===========================================================================
