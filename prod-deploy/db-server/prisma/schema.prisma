  workers            workers?    @relation(fields: [sending_worker_id], references: [worker_id], onDelete: NoAction, onUpdate: NoAction)
  shipments          shipments   @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipment_id], map: "idx_shipment_history_shipment_id")
}

