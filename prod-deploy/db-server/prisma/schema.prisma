/// Reference ("golden") items — a prototype per item type + manufacturer SKU,
/// with reference images used for automatic visual comparison during testing.
/// Infrastructure screen under Settings (/settings/reference-items).
/// `manufacturer_sku` is entered manually here (it is NOT sourced from `items`)
/// so this screen can be linked to other screens/flows in the future.
model reference_items {
  reference_item_id Int                     @id @default(autoincrement())
  item_type_id      Int
  manufacturer_sku  String                  @db.VarChar(255)
  manufacturer      String                  @db.VarChar(255)
  name              String?                 @db.VarChar(255)
  reference_weight  String?                 @db.VarChar(255)
  notes             String?                 @db.Text
  /// reference_item_images.reference_item_image_id of the cover image (app-managed, not a FK).
  primary_image_id  Int?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  item_types        item_types              @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction)
  images            reference_item_images[]

  @@index([item_type_id], map: "idx_reference_items_item_type")
  @@index([manufacturer_sku], map: "idx_reference_items_sku")
}

/// Image objects for a reference item. The bytes live in MinIO (the dedicated
/// `ru-reference-items` bucket); this row is the index — same procedure as
/// `file_objects`, kept alongside it so the whole item's images cascade-delete.
model reference_item_images {
  reference_item_image_id Int             @id @default(autoincrement())
  reference_item_id       Int
  bucket                  String          @db.VarChar(255)
  object_key              String          @unique @db.VarChar(1024)
  file_name               String          @db.VarChar(255)
  content_type            String?         @db.VarChar(255)
  size_bytes              BigInt          @default(0)
  sort_order              Int             @default(0)
  photo_type_id           Int
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  reference_items         reference_items @relation(fields: [reference_item_id], references: [reference_item_id], onDelete: Cascade)
  photo_types             photo_types     @relation(fields: [photo_type_id], references: [photo_type_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reference_item_id], map: "idx_reference_item_images_item")
  @@index([photo_type_id], map: "idx_reference_item_images_type")
}

/// Global photo classifications ("package", "product", ...). Screens address a
/// group by the stable `code`; the SERIAL id never leaks into UI code. Also
/// used (by code, via file_objects.metadata.photoType) to tag worker-captured
/// item photos so each screen lists only its own group.
model photo_types {
  photo_type_id   Int                     @id @default(autoincrement())
  code            String                  @unique @db.VarChar(50)
  photo_type_desc String                  @db.VarChar(255)
  sort_order      Int                     @default(0)
  is_active       Boolean                 @default(true)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  images          reference_item_images[]
}

