/// Per-item test result captured when a tester finishes a test at a station.
/// One row PER item — a parent and each of its accessories each get their own
/// row (accessories stay separate routed items). `details` holds the
/// station-type-specific structured payload (e.g. the "קליטה וצילום" intake
/// wizard fields); the station type is known from test_station_type_id, so no
/// type discriminator is stored inside the JSON. Additive to the existing flow:
/// item_route_history keeps the route/timing log, this holds the actual result.
model test_results {
  test_result_id       Int      @id @default(autoincrement())
  item_id              BigInt
  test_station_id      Int
  test_station_type_id Int
  route_number         Int      @default(1)
  route_step           Int
  worker_id            Int?
  passed               Boolean?
  result               Int?
  comments             String?  @db.Text
  details              Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  @@index([item_id], map: "idx_test_results_item")
  @@index([test_station_id], map: "idx_test_results_station")
  @@index([test_station_type_id], map: "idx_test_results_station_type")
}

