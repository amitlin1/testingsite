generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Central registry of every object stored in MinIO.
/// MinIO holds the bytes; this table is the index/audit log used for
/// orphan detection, auditing, dedup and fast listing.
model file_objects {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket          String    @db.VarChar(255)
  object_key      String    @unique @db.VarChar(1024)
  file_name       String    @db.VarChar(512)
  content_type    String?   @db.VarChar(255)
  size_bytes      BigInt    @default(0)
  checksum_sha256 String?   @db.VarChar(64)
  /// What owns this object: 'shipment_signature' | 'shipment_history_signature' | 'file_manager' | 'item_attachment'
  entity_type     String?   @db.VarChar(64)
  /// Owner id (shipment id, log id, item id, ...) as a string for flexibility
  entity_id       String?   @db.VarChar(64)
  metadata        Json?
  /// 'active' | 'deleted' (soft delete; bytes may still exist as a MinIO version)
  status          String    @default("active") @db.VarChar(20)
  created_by      String?   @db.VarChar(255)
  /// Who last modified the row (upload/replace/edit). Mirrors created_by for the first write.
  updated_by      String?   @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_file_objects_entity")
  @@index([status], map: "idx_file_objects_status")
  @@index([created_at], map: "idx_file_objects_created_at")
}

