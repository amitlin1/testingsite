# ===========================================================================
# APP SERVER  -  copy to .env and fill in every <<< >>> marker
# ===========================================================================
# There is no DNS on this network, so every address is an IP.
# Lines marked "= DB server: X" must match that line in the DB server's .env.
#
# Not listed here on purpose: the Keycloak issuer, AUTH_URL, DATABASE_URL,
# MINIO_ENDPOINT and the internal container addresses. They are derived from the
# values below in docker-compose.yml, so they cannot drift apart.
# ===========================================================================


# --- THIS server (application + Keycloak + OnlyOffice all run here) --------
# The address users type in their browser: THIS machine's IP. No trailing slash.
# The same address must be in the DB server's fixup-after-restore.sql.
APP_PUBLIC_URL=http://<<< APP SERVER IP >>>

# The OnlyOffice editor: same machine, own port (it cannot run under a path).
# This port must be reachable from CLIENT PCs, not just from the servers.
ONLYOFFICE_PUBLIC_URL=http://<<< APP SERVER IP >>>:8082

# Host ports. If you change these, change the two URLs above to match.
NGINX_PORT=80
ONLYOFFICE_HOST_PORT=8082


# --- The DB SERVER (the other machine) -------------------------------------
DB_HOST=<<< DB SERVER IP >>>

# = DB server: POSTGRES_PORT
DB_PORT=5432
# = DB server: POSTGRES_USER
DB_USER=appuser
# = DB server: POSTGRES_DB
DB_NAME=testingsite
# = DB server: POSTGRES_PASSWORD
DB_PASSWORD=<<< SAME PASSWORD AS THE DB SERVER >>>

# Keycloak's database - same PostgreSQL, same port, database name `keycloak`.
# = DB server: KEYCLOAK_DB_USER
KC_DB_USERNAME=keycloak
# = DB server: KEYCLOAK_DB_PASSWORD
KC_DB_PASSWORD=<<< SAME PASSWORD AS THE DB SERVER >>>

# = DB server: MINIO_PORT
MINIO_PORT=9000
# = DB server: MINIO_ROOT_USER
MINIO_ROOT_USER=digitalfactory-admin
# = DB server: MINIO_ROOT_PASSWORD
MINIO_ROOT_PASSWORD=<<< SAME PASSWORD AS THE DB SERVER >>>


# --- Keycloak console admin ------------------------------------------------
# Created on first start, for managing Keycloak itself. Separate from the
# application accounts. Console: <APP_PUBLIC_URL>/auth/admin
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=<<< SET A PASSWORD >>>


