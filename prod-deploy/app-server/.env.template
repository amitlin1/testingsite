MINIO_REFERENCE_BUCKET=ru-reference-items

# Upload limits (MB).
MAX_FILE_SIZE_MB=100
MAX_TEXT_EDIT_SIZE_MB=5

# Served at the site root. Leave empty.
NEXT_BASE_PATH=

# Never set IS_DEV in production - it BYPASSES ALL AUTHENTICATION.
# Set AUTH_DEBUG=1 temporarily to log the auth flow.
# IS_DEV=
AUTH_DEBUG=
