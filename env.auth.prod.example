# ===========================================
# App (Next.js) AUTH env — PRODUCTION template
# ===========================================
# The auth-related vars the app needs in production. Merge these into your app's
# prod env (e.g. .env.prod). Fill the CHANGE_ME values AFTER you regenerate the
# client secrets in Keycloak (Clients → Credentials → Regenerate). Do NOT set
# IS_DEV in production.
# ===========================================

# Realm issuer — the PUBLIC Keycloak URL + /realms/testing (matches KC_HOSTNAME).
AUTH_KEYCLOAK_ISSUER=https://CHANGE_ME_public_keycloak_host/realms/testing
NEXT_PUBLIC_AUTH_KEYCLOAK_ISSUER=https://CHANGE_ME_public_keycloak_host/realms/testing

# Login client. Secret = the REGENERATED `testing-web` secret from Keycloak.
AUTH_KEYCLOAK_ID=testing-web
AUTH_KEYCLOAK_SECRET=CHANGE_ME_regenerated_testing_web_secret

# Admin REST service account. Secret = the REGENERATED `testing-admin-api` secret.
KEYCLOAK_ADMIN_CLIENT_ID=testing-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_regenerated_testing_admin_api_secret

# Auth.js cookie encryption — generate fresh: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# Behind a reverse proxy.
AUTH_TRUST_HOST=true

# Empty = Keycloak's own (themed) login page (our realm has no brokered IdP).
AUTH_KEYCLOAK_IDP_HINT=

# Shared secret for /api/cron/* (must match the scheduler .bat's x-cron-secret).
CRON_SECRET=CHANGE_ME_strong_cron_secret

# OnlyOffice HS256 secret (also signs the file-download token).
ONLYOFFICE_JWT_SECRET=CHANGE_ME_onlyoffice_secret

# ONLY if the app is mounted under a sub-path behind the proxy:
# AUTH_URL=https://CHANGE_ME_public_app_host/<basePath>/api/auth
