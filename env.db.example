# ===========================================
# DB Server Environment Configuration
# ===========================================
# Copy this file to .env.db and fill in production values.
# These are used for initial PostgreSQL setup.
#
# IMPORTANT: Changing these after first run requires manual
# password update in PostgreSQL. See docs/RUNBOOK_DB_SERVER.md.
#
# SECURITY: Never commit .env.db to version control!
# ===========================================

# -----------------------------------------
# PostgreSQL Configuration
# -----------------------------------------
# Admin user for the database
POSTGRES_USER=appuser

# Strong password (generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=changeme_secure_password

# Database name to create
POSTGRES_DB=testingsite

# -----------------------------------------
# MinIO Object Storage
# -----------------------------------------
# Admin credentials for the MinIO container (S3-compatible object storage)
# Generate a strong password: openssl rand -base64 24
MINIO_ROOT_USER=digitalfactory-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# Bucket name (must match MINIO_BUCKET in .env.prod). Auto-created by the app.
MINIO_BUCKET=digitalfactory-files

# -----------------------------------------
# Backups (minio-backup + postgres-backup sidecars)
# -----------------------------------------
# IMPORTANT: these four are read by DOCKER COMPOSE (not injected into the
# container), so to override them put them in the project `.env` file (next to
# docker-compose.db.yml) or your shell — NOT here in .env.db. The defaults below
# already produce the requested layout, so you can leave them unset.
#
#   BACKUP_INTERVAL_SECONDS=86400      # how often each backup runs (86400 = 24h)
#   BACKUP_DAILY_RETENTION_DAYS=7      # daily pg dumps kept this many days
#   BACKUP_FILES_PATH=C:/backups/files     # MinIO mirror -> host folder
#   BACKUP_PG_PATH=C:/backups/postgres     # pg dumps   -> host folder
#
# Layout produced on the host:
#   C:/backups/files/...                 (mirror of the bucket)
#   C:/backups/postgres/daily/*.sql.gz   (kept 7 days)
#   C:/backups/postgres/monthly/*.sql.gz (kept forever)

# -----------------------------------------
# Optional: Advanced Settings
# -----------------------------------------
# These can be uncommented and adjusted as needed

# Maximum connections (default 100)
# POSTGRES_MAX_CONNECTIONS=100

# Shared buffers (default 128MB, recommended 25% of RAM)
# POSTGRES_SHARED_BUFFERS=256MB
