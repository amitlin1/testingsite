# ===========================================
# PROD Server Environment Configuration
# ===========================================
# Copy this file to .env.prod and fill in production values.
# Changes take effect on container restart (no rebuild needed).
#
# SECURITY: Never commit .env.prod to version control!
# ===========================================

# -----------------------------------------
# Database Connection
# -----------------------------------------
# Option 1: Full connection URL (recommended)
DATABASE_URL=postgresql://appuser:Strong_Pass_123@host.docker.internal:5432/InventoryDB

# Option 2: Individual variables (alternative to DATABASE_URL)
# If both are set, DATABASE_URL takes precedence
# DB_HOST=192.168.1.100
# DB_PORT=5432
# DB_USER=appuser
# DB_PASSWORD=changeme_secure_password
# DB_NAME=testingsite

DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=Strong_Pass_123
DB_NAME=InventoryDB



# -----------------------------------------
# Application Settings
# -----------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Secret for session/JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate_a_secure_random_string_here

# JWT secret if using custom JWT auth
# JWT_SECRET=another_secure_random_string

# -----------------------------------------
# Client Runtime Config (used by nginx)
# -----------------------------------------
# Base URL for client-side API calls (browser sees this)
# Leave empty if same-origin, or set to full URL if needed
APP_BASE_URL=

# Application version (for cache busting or display)
APP_VERSION=1.0.0

# Feature flags as JSON object
# Example: {"newDashboard": true, "betaFeatures": false}
FEATURE_FLAGS={}

# -----------------------------------------
# File Storage
# -----------------------------------------
# Path where shipment files (signatures, etc.) are saved
# Must match the volume mount in docker-compose.prod.yml
FILES_PATH=/data/shipments

# -----------------------------------------
# Nginx / Network Settings
# -----------------------------------------
# Port nginx binds to on the host (default: 80)
NGINX_PORT=80

# -----------------------------------------
# MinIO Object Storage (on DB server)
# -----------------------------------------
# These credentials must match what is set in .env.db on the DB server
MINIO_ROOT_USER=digitalfactory-admin
MINIO_ROOT_PASSWORD=Strong_Pass_123
# Point to the DB server IP/hostname, port 9000 must be open
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_BUCKET=digitalfactory-files

# -----------------------------------------
# OnlyOffice Document Server (in-browser .docx/.xlsx/.pptx editing)
# -----------------------------------------
# Shared HS256 secret. Auto-generated; rotate when desired with:
#   openssl rand -base64 32
ONLYOFFICE_JWT_SECRET=9dPyTOylmjz6bin7JHnttmxbZ9S2fmuW46vT2F2wLO4=

# Browser-reachable URL for the DocServer. OnlyOffice 9.x doesn't honour a
# reverse-proxy sub-path (its in-iframe JS generates /cache/, /coauthoring/
# etc. without prefix), so we expose it on its own host port instead.
# In prod, swap to the real hostname/port.
ONLYOFFICE_HOST_PORT=8082
ONLYOFFICE_PUBLIC_URL=http://localhost:8082

# Internal docker URL the Next.js callback uses to pull the saved file.
ONLYOFFICE_INTERNAL_URL=http://onlyoffice

# Browser-reachable URL of this app — OnlyOffice loads the source doc via it.
APP_PUBLIC_URL=http://nginx

# Same OnlyOffice URL exposed to the browser bundle (NEXT_PUBLIC_ baked at build-time).
NEXT_PUBLIC_ONLYOFFICE_PUBLIC_URL=http://localhost:8082
