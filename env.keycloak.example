# ===========================================
# Keycloak stack environment (TEMPLATE — safe to commit)
# ===========================================
# Copy this file to .env.keycloak and fill in real values.
# .env.keycloak is gitignored (matches .env.* in .gitignore) — never commit it.
#
# IMPORTANT: the database password appears twice — POSTGRES_PASSWORD (read by
# the postgres image) and KC_DB_PASSWORD (read by Keycloak). They point at the
# same DB user and MUST be identical.
# ===========================================

# -----------------------------------------
# Keycloak's PostgreSQL (read by the postgres image)
# -----------------------------------------
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_dev_db_password
POSTGRES_DB=keycloak

# -----------------------------------------
# Keycloak -> DB connection (read by Keycloak)
# -----------------------------------------
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_dev_db_password    # must equal POSTGRES_PASSWORD above

# -----------------------------------------
# Keycloak bootstrap admin (first-run temporary admin account)
# -----------------------------------------
# Used to log into the admin console the first time. For production, create a
# personal admin user afterwards and rotate/remove this bootstrap account.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_dev_admin_password
