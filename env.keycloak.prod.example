# ===========================================
# Keycloak PRODUCTION stack env (TEMPLATE — safe to commit)
# ===========================================
# Topology: Keycloak runs on the APP machine; its Postgres is on the SEPARATE DB
# machine. Copy to .env.keycloak.prod (gitignored) and fill with STRONG values
# (openssl rand -base64 24). The secrets you REGENERATE in Keycloak go into the
# APP's auth env (env.auth.prod.example), not here.
# ===========================================

# --- Keycloak -> remote PostgreSQL (on the DB machine) ---
# Point the host at the DB machine's address; DB name stays `keycloak`.
KC_DB_URL=jdbc:postgresql://CHANGE_ME_DB_MACHINE_HOST:5432/keycloak
KC_DB_USERNAME=keycloak
# Must equal the password set in keycloak/keycloak-db-init.sql.
KC_DB_PASSWORD=CHANGE_ME_strong_db_password

# --- Public URL Keycloak is served at, THROUGH nginx/TLS ---
# Exact external origin, e.g. https://keycloak.factory.local
KC_HOSTNAME=https://CHANGE_ME_public_keycloak_host

# --- Bootstrap admin (first run only) ---
# Log in once, create a personal admin + the first app manager, then rotate this.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
