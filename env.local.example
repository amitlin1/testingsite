# ===========================================
# Local Development Environment Configuration
# ===========================================
# Copy this file to .env.local for laptop testing.
# Next.js automatically loads .env.local in development.
#
# SCENARIO: Next.js runs in Docker container, Postgres runs in
# another Docker container published to host port 5432.
# Use 'host.docker.internal' to reach the host from inside a container.
#
# If running Next.js directly on the host (npm run dev), use localhost.
# ===========================================

# -----------------------------------------
# Database Connection
# -----------------------------------------
# For Next.js running in Docker container connecting to Postgres on host:
DB_HOST=host.docker.internal

# For Next.js running directly on host (npm run dev):
# DB_HOST=localhost

DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password_here
DB_NAME=testingsite

# Alternative: Full connection URL (overrides individual vars if set)
# DATABASE_URL=postgresql://postgres:your_local_password_here@host.docker.internal:5432/testingsite

# Optional: Enable SSL for database connection
# DB_SSL=true

# -----------------------------------------
# Application Settings
# -----------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Secret for session/JWT signing (can use a simple value for local dev)
NEXTAUTH_SECRET=local_dev_secret_change_in_prod

# -----------------------------------------
# File Storage (MinIO — the only storage backend)
# -----------------------------------------
# Reach MinIO from a container with host.docker.internal, or localhost on host.
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ROOT_USER=digitalfactory-admin
MINIO_ROOT_PASSWORD=your_local_minio_password_here
MINIO_BUCKET=digitalfactory-files
MAX_FILE_SIZE_MB=100

# -----------------------------------------
# Nginx (if using docker-compose locally)
# -----------------------------------------
NGINX_PORT=3080
