generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Central registry of every object stored in MinIO.
/// MinIO holds the bytes; this table is the index/audit log used for
/// orphan detection, auditing, dedup and fast listing.
model file_objects {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket          String    @db.VarChar(255)
  object_key      String    @unique @db.VarChar(1024)
  file_name       String    @db.VarChar(512)
  content_type    String?   @db.VarChar(255)
  size_bytes      BigInt    @default(0)
  checksum_sha256 String?   @db.VarChar(64)
  /// What owns this object: 'shipment_signature' | 'shipment_history_signature' | 'file_manager' | 'item_attachment'
  entity_type     String?   @db.VarChar(64)
  /// Owner id (shipment id, log id, item id, ...) as a string for flexibility
  entity_id       String?   @db.VarChar(64)
  metadata        Json?
  /// 'active' | 'deleted' (soft delete; bytes may still exist as a MinIO version)
  status          String    @default("active") @db.VarChar(20)
  created_by      String?   @db.VarChar(255)
  /// Who last modified the row (upload/replace/edit). Mirrors created_by for the first write.
  updated_by      String?   @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_file_objects_entity")
  @@index([status], map: "idx_file_objects_status")
  @@index([created_at], map: "idx_file_objects_created_at")
}

model customers {
  id            Int    @id @default(autoincrement())
  name          String @db.Char(50)
  customer_code String @db.VarChar(100)
}

model daily_counters {
  date_key DateTime @id @db.Date
  counter  Int?     @default(0)
}

model item_route_history {
  log_id                Int       @id @default(autoincrement())
  item_id               BigInt
  test_station_id       Int
  current_route_step    Int
  queue_start_time      DateTime? @db.Timestamp(6)
  processing_start_time DateTime? @db.Timestamp(6)
  processing_end_time   DateTime? @db.Timestamp(6)
  worker_id             Int?
  route_number          Int       @default(1)

  @@index([item_id], map: "idx_irh_item_id")
  @@index([test_station_id], map: "idx_irh_station_id")
  @@index([processing_end_time], map: "idx_irh_processing_end_time")
  @@index([worker_id], map: "idx_irh_worker_id")
}

model item_routes {
  item_id               BigInt         @id @default(autoincrement())
  item_type_id          Int
  current_status        Int
  current_route_step    Int
  test_station_id       Int?
  created_at            DateTime       @db.Timestamp(6)
  finished_at           DateTime?      @db.Timestamp(6)
  is_finished           Boolean        @default(false)
  queue_start_time      DateTime       @db.Timestamp(6)
  processing_start_time DateTime?      @db.Timestamp(6)
  route_number          Int            @default(1)
  item_types            item_types     @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_routes_item_type")
  test_stations         test_stations? @relation(fields: [test_station_id], references: [test_station_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_routes_test_station")

  @@index([current_status], map: "idx_ir_current_status")
  @@index([test_station_id], map: "idx_ir_test_station_id")
  @@index([finished_at], map: "idx_ir_finished_at")
  @@index([is_finished], map: "idx_ir_is_finished")
}

model item_status {
  item_status_id   Int    @id @default(autoincrement())
  item_status_desc String @unique @db.Char(50)
}

model item_types {
  item_type_id     Int                @id @default(autoincrement())
  item_type_desc   String             @unique @db.Char(50)
  item_routes      item_routes[]
  reference_items  reference_items[]
  shipment_history shipment_history[]
  shipment_items   shipment_items[]
  testing_routes   testing_routes[]
}

/// Reference ("golden") items — a prototype per item type + manufacturer SKU,
/// with reference images used for automatic visual comparison during testing.
/// Infrastructure screen under Settings (/settings/reference-items).
/// `manufacturer_sku` is entered manually here (it is NOT sourced from `items`)
/// so this screen can be linked to other screens/flows in the future.
model reference_items {
  reference_item_id Int                     @id @default(autoincrement())
  item_type_id      Int
  manufacturer_sku  String                  @db.VarChar(255)
  manufacturer      String                  @db.VarChar(255)
  name              String?                 @db.VarChar(255)
  reference_weight  String?                 @db.VarChar(255)
  notes             String?                 @db.Text
  /// reference_item_images.reference_item_image_id of the cover image (app-managed, not a FK).
  primary_image_id  Int?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  item_types        item_types              @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction)
  images            reference_item_images[]

  @@index([item_type_id], map: "idx_reference_items_item_type")
  @@index([manufacturer_sku], map: "idx_reference_items_sku")
}

/// Image objects for a reference item. The bytes live in MinIO (the dedicated
/// `ru-reference-items` bucket); this row is the index — same procedure as
/// `file_objects`, kept alongside it so the whole item's images cascade-delete.
model reference_item_images {
  reference_item_image_id Int             @id @default(autoincrement())
  reference_item_id       Int
  bucket                  String          @db.VarChar(255)
  object_key              String          @unique @db.VarChar(1024)
  file_name               String          @db.VarChar(255)
  content_type            String?         @db.VarChar(255)
  size_bytes              BigInt          @default(0)
  sort_order              Int             @default(0)
  photo_type_id           Int
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  reference_items         reference_items @relation(fields: [reference_item_id], references: [reference_item_id], onDelete: Cascade)
  photo_types             photo_types     @relation(fields: [photo_type_id], references: [photo_type_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reference_item_id], map: "idx_reference_item_images_item")
  @@index([photo_type_id], map: "idx_reference_item_images_type")
}

/// Global photo classifications ("package", "product", ...). Screens address a
/// group by the stable `code`; the SERIAL id never leaks into UI code. Also
/// used (by code, via file_objects.metadata.photoType) to tag worker-captured
/// item photos so each screen lists only its own group.
model photo_types {
  photo_type_id   Int                     @id @default(autoincrement())
  code            String                  @unique @db.VarChar(50)
  photo_type_desc String                  @db.VarChar(255)
  sort_order      Int                     @default(0)
  is_active       Boolean                 @default(true)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  images          reference_item_images[]
}

model items {
  item_id           BigInt  @id
  customer_id       Int
  item_type_id      Int
  serial_no         String
  makat             String
  model             String  @db.Char(50)
  manufacturer_name String  @db.Char(50)
  manufacturer_no   String
  shipment_id       Int
  parent_item_id    BigInt?
  items             items?  @relation("itemsToitems", fields: [parent_item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
  other_items       items[] @relation("itemsToitems")
}

model research_history {
  research_id Int       @id @default(autoincrement())
  item_id     BigInt
  station_id  Int
  sent_at     DateTime? @db.Timestamp(6)
  return_at   DateTime? @db.Timestamp(6)
  result      Int
  comments    String?
  worker_id   Int?
}

/// Per-item test result captured when a tester finishes a test at a station.
/// One row PER item — a parent and each of its accessories each get their own
/// row (accessories stay separate routed items). `details` holds the
/// station-type-specific structured payload (e.g. the "קליטה וצילום" intake
/// wizard fields); the station type is known from test_station_type_id, so no
/// type discriminator is stored inside the JSON. Additive to the existing flow:
/// item_route_history keeps the route/timing log, this holds the actual result.
model test_results {
  test_result_id       Int      @id @default(autoincrement())
  item_id              BigInt
  test_station_id      Int
  test_station_type_id Int
  route_number         Int      @default(1)
  route_step           Int
  worker_id            Int?
  passed               Boolean?
  result               Int?
  comments             String?  @db.Text
  details              Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  // Anchor to the ledger event of the submission that wrote this row (call
  // site #14, migration 20260825000000_metrics_ledger_additive). Plain bigint
  // on purpose — the migration adds no FK.
  state_event_id       BigInt?

  @@index([item_id], map: "idx_test_results_item")
  @@index([test_station_id], map: "idx_test_results_station")
  @@index([test_station_type_id], map: "idx_test_results_station_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipment_history {
  log_id             Int         @id @default(autoincrement())
  shipment_id        Int
  sent_shipment_code String
  sent_date          DateTime    @db.Timestamp(6)
  sending_worker_id  Int?
  // Keycloak display name at the time this row was written (worker_id is now
  // the Keycloak employeeNumber, unenforced — no local `workers` table left
  // to join against).
  sending_worker_name String?
  item_type_id       Int?
  makat              String?
  amount             Int
  created_at         DateTime?   @default(now()) @db.Timestamp(6)
  signature_path     String?
  item_types         item_types? @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction)
  shipments          shipments   @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shipment_id], map: "idx_shipment_history_shipment_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipment_items {
  id           Int         @id @default(autoincrement())
  shipment_id  Int?
  item_type_id Int?
  quantity     Int
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  makat        String?
  item_types   item_types? @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction)
  shipments    shipments?  @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shipments {
  id                                             Int                @id @default(autoincrement())
  shipment_code                                  String             @db.VarChar(20)
  customer_id                                    Int
  shipment_date                                  DateTime           @db.Timestamp(6)
  makat                                          String
  amount                                         Int
  shipment_sent_date                             DateTime?          @db.Timestamp(6)
  is_sent                                        Boolean?           @default(false)
  recieving_worker_id                            Int?
  recieving_worker_name                          String?
  source_id                                      Int?
  sending_worker_id                              Int?
  sending_worker_name                            String?
  finished_at                                    DateTime?          @db.Timestamptz(6)
  signature_path                                 String?
  shipment_history                               shipment_history[]
  shipment_items                                 shipment_items[]
  poc_details                                    String?            @db.VarChar(255)
}

model sources {
  source_id   Int    @id @default(autoincrement())
  source_desc String @unique @db.VarChar(100)

  @@index([source_desc], map: "idx_sources_desc")
}

model test_station_status {
  test_station_status_id   Int    @id @default(autoincrement())
  test_station_status_desc String @unique @db.Char(50)
}

model test_stations {
  test_station_id      Int                @id @default(autoincrement())
  test_station_type_id Int
  test_station_desc    String             @unique @db.Char(50)
  status               Int
  is_research          Boolean            @default(false)
  item_routes          item_routes[]
  test_stations_type   test_stations_type @relation(fields: [test_station_type_id], references: [test_station_type_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_test_stations_test_station_type")
}

model test_stations_type {
  test_station_type_id Int              @id @default(autoincrement())
  test_type_desc       String           @unique @db.Char(50)
  // Stations of this type test a parent item together with its accessories,
  // so the queue lists parents only and hides the accessory items.
  parents_only         Boolean          @default(false)
  // Minutes an item may sit in status 1/5 on a station of this type with no
  // result before /api/cron/release-stale-tests reverts it and frees the
  // station. 0 = never auto-release this type (burn-in chambers, research
  // benches that legitimately hold a unit for days). NOT NULL DEFAULT 30 keeps
  // a newly created type fail-safe; "never" has to be typed in deliberately.
  stale_after_minutes  Int              @default(30)
  test_stations        test_stations[]
  testing_routes       testing_routes[]
}

model testing_routes {
  test_route_id        Int                @id @default(autoincrement())
  item_type_id         Int
  test_station_type_id Int
  route_steps          Int[]              @default([])
  route_number         Int                @default(1)
  item_types           item_types         @relation(fields: [item_type_id], references: [item_type_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testing_routes_item_type")
  test_stations_type   test_stations_type @relation(fields: [test_station_type_id], references: [test_station_type_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testing_routes_test_station_type")
}

// ============================================================================
// שעות עבודה וחופשות — a single department, so no department_id anywhere.
// National holidays (חגי ישראל) are NOT stored here: they are computed from
// the Hebrew calendar at read time (src/lib/workHours/israeliHolidays.ts).
// These tables hold only what a human enters. Clock values are "HH:mm" strings
// and dates are @db.Date so they never fight timezones.
// ============================================================================

/// The department's weekly template. Exactly 7 rows (weekday 0=ראשון … 6=שבת).
model weekday_defaults {
  weekday     Int      @id
  is_working  Boolean  @default(true)
  start_time  String?  @db.VarChar(5)
  end_time    String?  @db.VarChar(5)
  break_start String?  @db.VarChar(5)
  break_end   String?  @db.VarChar(5)
  updated_by  String?  @db.VarChar(255)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// A single-date manual exception that beats the weekly template.
/// kind: 'vacation' | 'short_hours' | 'short_day' | 'friday_work' | 'eve_work'
model workday_overrides {
  id          Int      @id @default(autoincrement())
  work_date   DateTime @unique @db.Date
  kind        String   @db.VarChar(20)
  start_time  String?  @db.VarChar(5)
  end_time    String?  @db.VarChar(5)
  break_start String?  @db.VarChar(5)
  break_end   String?  @db.VarChar(5)
  note        String?  @db.VarChar(500)
  created_by  String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([work_date], map: "idx_workday_overrides_date")
}

/// Manageable categories for the department's internal absences.
/// is_system = true for the seeded ones (renameable, never deletable).
model holiday_types {
  id         Int                   @id @default(autoincrement())
  name       String                @unique @db.VarChar(100)
  is_system  Boolean               @default(false)
  created_at DateTime              @default(now()) @db.Timestamptz(6)
  holidays   department_holidays[]
}

/// A department-wide internal absence (חופשה מרוכזת / יום גיבוש / השבתה …).
/// NOT national holidays — those come from the Hebrew-calendar library.
model department_holidays {
  id                Int           @id @default(autoincrement())
  name              String        @db.VarChar(200)
  type_id           Int
  start_date        DateTime      @db.Date
  end_date          DateTime      @db.Date
  is_half_day       Boolean       @default(false)
  /// Only meaningful when is_half_day — the department works until this time.
  half_day_end_time String?       @db.VarChar(5)
  note              String?       @db.VarChar(500)
  created_by        String?       @db.VarChar(255)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  type              holiday_types @relation(fields: [type_id], references: [id])

  @@index([start_date, end_date], map: "idx_department_holidays_range")
}

// ============================================================================
// CIL — the metrics ledger (docs/dashboard-migration-plan-v2.md §3, migration
// 20260825000000_metrics_ledger_additive). Declared here so `prisma migrate
// dev` treats the tables as OWNED (never drop candidates). The DDL itself is
// hand-written SQL: the functions, triggers, EXCLUDE/CHECK constraints and
// partial indexes are NOT modeled — see docs/PRISMA_UNMANAGED_OBJECTS.md.
// Range columns use Unsupported("tstzrange"); all reads/writes of these tables
// go through raw SQL, never through generated CRUD.
// ============================================================================

/// Status vocabulary (§3.1) — live definitions instead of hardcoded 1..5.
model metric_state {
  state_key        String  @id
  legacy_status_id Int?    @unique @db.SmallInt
  label_he         String
  is_terminal      Boolean @default(false)
  is_waiting       Boolean @default(false)
  is_active_work   Boolean @default(false)
  is_research      Boolean @default(false)
  at_station       Boolean @default(false)
  sort_order       Int     @db.SmallInt

  events    item_state_event[]
  intervals item_state_interval[]
}

/// One pass of one item through one route (§3.2). unit_id = COALESCE(parent_item_id, item_id).
model route_run {
  route_run_id   BigInt    @id @default(autoincrement())
  item_id        BigInt
  run_no         Int       @default(1)
  route_number   Int
  item_type_id   Int
  planned_steps  Int[]     @default([])
  plan_digest    String    @default("")
  opened_at      DateTime  @db.Timestamptz(6)
  closed_at      DateTime? @db.Timestamptz(6)
  close_reason   String?
  customer_id    Int
  shipment_id    Int
  parent_item_id BigInt?
  unit_id        BigInt
  is_accessory   Boolean
  serial_no      String    @default("")
  is_trusted     Boolean   @default(true)

  events    item_state_event[]
  intervals item_state_interval[]

  @@unique([item_id, run_no], map: "route_run_uq")
}

/// The append-only spine (§3.3) — immutable (deny_mutation trigger), idempotent
/// via event_key. Canonical order key: (occurred_at, seq, event_id).
model item_state_event {
  event_id        BigInt   @id @default(autoincrement())
  event_key       String   @unique(map: "ise_key_uq")
  route_run_id    BigInt
  item_id         BigInt
  occurred_at     DateTime @db.Timestamptz(6)
  recorded_at     DateTime @default(now()) @db.Timestamptz(6)
  seq             Int      @default(0) @db.SmallInt
  kind            String
  to_state        String?
  step_no         Int
  station_id      Int?
  station_type_id Int?
  worker_id       Int?
  worker_name     String?
  reason          String
  submit_id       String?  @db.Uuid
  supersedes      BigInt?
  is_trusted      Boolean  @default(true)
  payload         Json     @default("{}")

  run              route_run             @relation(fields: [route_run_id], references: [route_run_id], onDelete: NoAction, onUpdate: NoAction)
  state            metric_state?         @relation(fields: [to_state], references: [state_key], onDelete: NoAction, onUpdate: NoAction)
  superseded_event item_state_event?     @relation("event_supersedes", fields: [supersedes], references: [event_id], onDelete: NoAction, onUpdate: NoAction)
  superseded_by    item_state_event[]    @relation("event_supersedes")
  entry_intervals  item_state_interval[] @relation("interval_entry_event")
  exit_intervals   item_state_interval[] @relation("interval_exit_event")

  @@index([route_run_id, occurred_at, seq, event_id], map: "ise_run")
  @@index([item_id, occurred_at], map: "ise_item")
}

/// The ledger (§3.6) — one interval per state occupancy of each routed item.
/// The EXCLUDE constraint (isi_no_overlap), the partial indexes and the
/// GENERATED offhours_seconds expression live only in the SQL migration.
model item_state_interval {
  interval_id            BigInt                   @id @default(autoincrement())
  route_run_id           BigInt
  item_id                BigInt
  state_key              String
  is_terminal            Boolean                  @default(false)
  step_no                Int
  attempt_no             Int                      @default(1)
  station_id             Int?
  station_type_id        Int?
  entered_by_worker_id   Int?
  entered_by_worker_name String?
  exited_by_worker_id    Int?
  exited_by_worker_name  String?
  entry_reason           String
  exit_reason            String?
  entry_event_id         BigInt
  exit_event_id          BigInt?
  valid_range            Unsupported("tstzrange")
  closed_at              DateTime?                @db.Timestamptz(6)
  start_business_date    DateTime                 @db.Date
  close_business_date    DateTime?                @db.Date
  customer_id            Int
  shipment_id            Int
  item_type_id           Int
  unit_id                BigInt
  is_accessory           Boolean
  serial_no              String                   @default("")
  wall_seconds           Decimal?                 @db.Decimal(14, 3)
  work_seconds           Decimal?                 @db.Decimal(14, 3)
  offhours_seconds       Decimal?                 @default(dbgenerated("(wall_seconds - work_seconds)")) @db.Decimal(14, 3)
  calendar_version       Int?
  is_trusted             Boolean                  @default(true)
  sys_from               DateTime                 @default(now()) @db.Timestamptz(6)

  run         route_run         @relation(fields: [route_run_id], references: [route_run_id], onDelete: Cascade, onUpdate: NoAction)
  state       metric_state      @relation(fields: [state_key], references: [state_key], onDelete: NoAction, onUpdate: NoAction)
  entry_event item_state_event  @relation("interval_entry_event", fields: [entry_event_id], references: [event_id], onDelete: NoAction, onUpdate: NoAction)
  exit_event  item_state_event? @relation("interval_exit_event", fields: [exit_event_id], references: [event_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([route_run_id, step_no, attempt_no], map: "isi_run")
}

/// Versioned work calendar (§3.5) — one row per generated horizon; the partial
/// unique index wcv_one_current enforces a single is_current row.
model work_calendar_version {
  calendar_version Int      @id @default(autoincrement())
  generated_at     DateTime @default(now()) @db.Timestamptz(6)
  horizon_from     DateTime @db.Date
  horizon_to       DateTime @db.Date
  source_digest    String
  is_current       Boolean  @default(false)

  spans work_span[]
}

/// One continuous working window (§3.5) — a break splits a day in two. The
/// prefix-sum ladder that work_seconds_between() walks with two index probes.
model work_span {
  calendar_version   Int
  span_id            BigInt                   @default(autoincrement())
  work_date          DateTime                 @db.Date
  span               Unsupported("tstzrange")
  span_seconds       Int
  cum_seconds_before BigInt

  version work_calendar_version @relation(fields: [calendar_version], references: [calendar_version], onDelete: Cascade, onUpdate: NoAction)

  @@id([calendar_version, span_id])
}

/// Scheduled-job audit surface (§3.9/§10.1) — written by the runJob wrapper.
model job_run {
  job_run_id    BigInt    @id @default(autoincrement())
  job_name      String
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  status        String    @default("running")
  rows_affected BigInt?
  detail        Json?
  error_text    String?
  host          String?

  @@index([job_name, started_at(sort: Desc)], map: "job_run_recent")
}

/// Single-row schema gate (§3.9) — read by GET /api/health/schema and by the
/// write path's version gate.
model metrics_schema_version {
  id         Int      @id @default(1)
  version    Int
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

