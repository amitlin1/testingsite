# ===========================================
# DEV Server Environment Configuration
# ===========================================
# Automatically loaded by Next.js in development (npm run dev)
#
# SECURITY: Never commit .env.development if it contains real secrets!
# ===========================================

# -----------------------------------------
# Database Connection
# -----------------------------------------
# Connect to Postgres running in Docker on localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=Strong_Pass_123
DB_NAME=InventoryDB
DATABASE_URL="postgresql://appuser:Strong_Pass_123@localhost:5432/InventoryDB?schema=public"

# -----------------------------------------
# Application Settings
# -----------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Secret for session/JWT signing
NEXTAUTH_SECRET=local_dev_secret_change_in_prod

# -----------------------------------------
# Client Runtime Config (used by nginx - optional in dev)
# -----------------------------------------
APP_BASE_URL=
APP_VERSION=1.0.0-dev
FEATURE_FLAGS={}

# -----------------------------------------
# File Storage (MinIO — the only storage backend)
# -----------------------------------------
# All files (signatures + file manager) are stored in MinIO. Start it with:
#   docker compose -f docker-compose.db.yml up -d minio
# Credentials must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in .env.db.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=digitalfactory-admin
MINIO_ROOT_PASSWORD=Strong_Pass_123
MINIO_BUCKET=digitalfactory-files
# Dedicated bucket for reference-item images (the "RU" bucket). Must be a valid
# S3/MinIO name (lowercase, 3-63 chars) — the literal "RU" is not valid.
MINIO_REFERENCE_BUCKET=ru-reference-items
# Max upload size per file (MB) for the file manager
MAX_FILE_SIZE_MB=100

# Legacy local path — only used by scripts/migrate-signatures-to-minio.mjs
# to find pre-migration signature files. Safe to remove after migration.
FILES_PATH=C:/Amit_Projects/Shipments-Files

# -----------------------------------------
# Nginx / Network Settings
# -----------------------------------------
NGINX_PORT=3080
